  user-select: none;
  opacity: var(--emoji-opacity);
  rotate: var(--emoji-rotate);
  line-height: 1;
  position: absolute;
  translate: -50% -50%;
}

.emoji-tile.is-bob {
  will-change: translate;
  animation: emoji-bob var(--emoji-duration) ease-in-out var(--emoji-delay) infinite alternate;
}

.emoji-tile.is-glitch {
  animation: emoji-glitch 9.5s steps(1, end) calc(var(--emoji-delay) * 1.6) infinite;
}

