  0%, 91%, 100% {
    opacity: var(--emoji-opacity);
    scale: 1;
  }

  92% {
    opacity: calc(var(--emoji-opacity) * .15);
    scale: 1.18 .82;
  }

  94% {
    opacity: var(--emoji-opacity);
    scale: 1;
  }

  95.5% {
    opacity: calc(var(--emoji-opacity) * .3);
    scale: .9 1.12;
  }

  97% {
    opacity: var(--emoji-opacity);
    scale: 1;
  }
}

@keyframes emoji-bob {
  from {
    translate: -50% calc(-50% - 4px);
  }

  to {
    translate: -50% calc(4px - 50%);
  }
}

