.emoji-drift {
  contain: layout style paint;
  will-change: transform;
  animation: 26s ease-in-out infinite emoji-drift-a;
  position: absolute;
  inset: 0;
}

.emoji-layer:nth-child(2) .emoji-drift {
  animation-name: emoji-drift-b;
  animation-duration: 21s;
}

