.screen-body {
  flex-direction: column;
  flex: 1;
  min-height: 0;
  display: flex;
  position: relative;
}

.screen-content, .screen-panel {
  overscroll-behavior-y: contain;
  scrollbar-width: none;
  justify-content: safe center;
  overflow: hidden auto;
}

.screen-content::-webkit-scrollbar {
  display: none;
}

.screen-panel::-webkit-scrollbar {
  display: none;
}

.bio-screen::-webkit-scrollbar {
  display: none;
}

.techtree-body::-webkit-scrollbar {
  display: none;
}

.bio-screen, .techtree-body {
  scrollbar-width: none;
}

@keyframes panel-out {
  from {
    opacity: 1;
  }

  to {
    opacity: 0;
  }
}

.screen-body[data-panel] .screen-content {
  visibility: hidden;
}

.screen-panel {
  z-index: 41;
  outline: none;
  flex-direction: column;
  animation: .66s cubic-bezier(.14, .88, .2, 1) both screen-settle;
  display: flex;
  position: absolute;
  inset: 0;
}

.screen-panel[data-state="closed"] {
  animation: .2s ease-in both panel-out;
}

.screen-panel h1, .screen-panel h2 {
  letter-spacing: 0;
  line-height: .94;
}

.techtree-screen .screen-kicker {
  margin-bottom: .28rem;
}

.techtree-body {
  margin-top: .4rem;
  padding-bottom: .2rem;
}

.tech-root {
  padding: .28rem .8rem;
}

.tech-trunk {
  height: .6rem;
}

.tech-langs, .tech-branch {
  width: min(100%, 34rem);
}

.tech-langs {
  margin-top: .5rem;
}

.tech-branch {
  gap: .35rem;
  margin-top: .45rem;
  padding: .45rem;
}

.tech-group {
  gap: .4rem;
  padding: .2rem .35rem;
}

.tech-chip {
  padding-block: .1rem;
}

.bio-screen {
  gap: clamp(.3rem, 1vw, .45rem);
  padding-top: clamp(.5rem, 2vw, .85rem);
  padding-bottom: clamp(.35rem, 1.6vw, .6rem);
}

.contact-link {
  line-height: 1.15;
}

.console-stage {
  --stage-pad: clamp(0rem, 2vw, 1.5rem);
  padding: var(--stage-pad);
}

@supports (zoom: tan(atan2(1px, 1px))) {
  @media (width >= 42rem) {
    .console-shell {
      zoom: min(1, tan(atan2(100svh - 2 * var(--stage-pad), 928px)));
      height: 58rem;
      max-height: none;
    }
  }
}

