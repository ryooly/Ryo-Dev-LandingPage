@keyframes screen-in {
  from {
    opacity: 0;
    transform: translateY(6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes screen-boot {
  0% {
    opacity: 0;
    filter: brightness(2.1);
    transform: scaleY(1.04);
  }

  40% {
    opacity: 1;
    filter: brightness(1.3);
  }

  100% {
    opacity: 1;
    filter: brightness();
    transform: scaleY(1);
  }
}

@keyframes screen-settle {
  0% {
    opacity: 0;
    transform: translateY(16px) scale(.982);
  }

  46% {
    opacity: 1;
  }

  70% {
    transform: translateY(-2.5px) scale(1.0025);
  }

  86% {
    transform: translateY(.9px) scale(1);
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes screen-ignite {
  0% {
    opacity: .7;
  }

  46% {
    opacity: .14;
  }

  70% {
    opacity: .03;
  }

  100% {
    opacity: 0;
  }
}

